# Copiare in .env.local (sviluppo) e impostare su Vercel (Project Settings → Environment Variables).

# ID di misurazione Google Analytics 4 (es. G-XXXXXXXXXX).
# Se vuoto, Google Analytics non viene caricato.
NEXT_PUBLIC_GA_ID=

# Form contatti (Resend).
RESEND_API_KEY=
# Mittente. Finché il dominio non è verificato su Resend usare: onboarding@resend.dev
CONTACT_FROM="TecnoChianti · Contatti <contatti@tecnochianti.it>"
# Destinatari separati da virgola (non compaiono sul sito)
CONTACT_RECIPIENTS=
